---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="SkyResell is a discounted flat-rate airline ticket resale marketplace."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>SkyResell | Discounted Flat-Rate Airline Tickets</title>
  </head>
  <body>
    <main class="min-h-screen bg-slate-50 px-6 py-16 text-slate-950">
      <section class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
        <p class="rounded-full bg-sky-100 px-4 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">
          SkyResell
        </p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
          Discounted airline tickets at one flat rate.
        </h1>
        <p class="text-lg leading-8 text-slate-600">
          A minimal Astro and Bun foundation for the SkyResell flight resale experience.
        </p>
        <a
          class="rounded-full bg-slate-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-sky-700"
          href="#"
        >
          Placeholder CTA
        </a>
      </section>
    </main>
  </body>
</html>
