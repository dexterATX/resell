    font-size: var(--step--1);
  }

  .header__toggle {
    display: none;
    width: 2.8rem;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.32rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
