  .header__brand {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-full);
    color: var(--color-soft-white);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .header__brand::before {
    width: 0.72rem;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    content: "";
    background: var(--gradient-primary);
    box-shadow: var(--shadow-glow), var(--shadow-cyan-glow);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-fog);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .header__nav a:not(.btn) {
    border-radius: var(--radius-full);
    padding: 0.65rem 0.8rem;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }

  .header__nav a:not(.btn):hover {
    color: var(--color-soft-white);
    background: rgb(248 250 252 / 0.08);
  }

  .header__cta {
    margin-inline-start: var(--space-xs);
    min-height: 2.7rem;
