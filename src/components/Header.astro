    backdrop-filter: blur(calc(var(--blur-glass) + 8px)) saturate(150%);
    -webkit-backdrop-filter: blur(calc(var(--blur-glass) + 8px)) saturate(150%);
    transition: max-height var(--duration-slow) var(--ease-out), opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), padding-block var(--duration-base) var(--ease-out);
  }

  .site-header[data-open="true"] .header__mobile {
    max-height: 24rem;
    padding-block: var(--space-sm);
    opacity: 1;
    transform: translateY(0);
    border-bottom-color: var(--color-border);
  }

  .header__mobile a:not(.btn) {
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    color: var(--color-fog);
    font-family: var(--font-display);
    font-weight: 800;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }

  .header__mobile a:not(.btn):hover {
