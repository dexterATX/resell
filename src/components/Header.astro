<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="FLATFARE home">
      <span class="site-header__brand-mark" aria-hidden="true"></span>
      <span>FLATFARE</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      <div class="site-header__links" data-mobile-nav aria-hidden="false">
        <a class="site-header__link" href="#destinations">Destinations</a>
        <a class="site-header__link" href="#how-it-works">How It Works</a>
        <a class="site-header__link" href="#pricing">Pricing</a>
        <a class="site-header__link" href="#faq">FAQ</a>
        <a class="btn btn-primary site-header__cta site-header__cta--mobile" href="#destinations">Browse Deals</a>
      </div>

      <a class="btn btn-primary site-header__cta site-header__cta--desktop" href="#destinations">Browse Deals</a>
    </nav>

    <button class="site-header__menu-toggle" type="button" aria-label="Open navigation menu" aria-controls="primary-navigation" aria-expanded="false" data-menu-toggle>
      <span class="site-header__menu-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script is:inline>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-mobile-nav]');

  const setMenuState = (isOpen) => {
    header?.classList.toggle('is-open', isOpen);
    toggle?.setAttribute('aria-expanded', String(isOpen));
    toggle?.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    nav?.setAttribute('aria-hidden', String(!isOpen));
  };

  toggle?.addEventListener('click', () => {
    const isOpen = !header?.classList.contains('is-open');
    setMenuState(isOpen);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 50rem)').matches) {
      setMenuState(false);
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid rgb(248 250 252 / 0.1);
    background: rgb(10 10 26 / 0.58);
    backdrop-filter: blur(var(--blur-glass)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(150%);
  }

  .site-header::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08), transparent 70%);
    pointer-events: none;
  }

  .site-header__inner {
    display: flex;
    min-height: clamp(4.25rem, 7vw, 5rem);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-soft-white);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .site-header__brand-mark {
    display: inline-block;
    width: clamp(2.2rem, 4vw, 2.75rem);
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background: var(--gradient-primary);
    box-shadow: var(--shadow-glow);
  }

  .site-header__brand-mark::after {
    position: absolute;
    inset: 34%;
    border-radius: var(--radius-full);
    content: "";
    background: var(--color-soft-white);
    box-shadow: 0 0 22px rgb(248 250 252 / 0.72);
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.5vw, 1.2rem);
  }

  .site-header__link {
    color: var(--color-fog);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .site-header__link:hover {
    color: var(--color-soft-white);
  }

  .site-header__cta--mobile {
    display: none;
  }

  .site-header__menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.08);
    color: var(--color-soft-white);
    cursor: pointer;
  }

  .site-header__menu-icon,
  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
    transition: transform var(--duration-base) var(--ease-out), opacity var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }

  .site-header__menu-icon {
    position: relative;
  }

  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    position: absolute;
    left: 0;
    content: "";
  }

  .site-header__menu-icon::before {
    transform: translateY(-0.4rem);
  }

  .site-header__menu-icon::after {
    transform: translateY(0.4rem);
  }

  .site-header.is-open .site-header__menu-icon {
    background: transparent;
  }

  .site-header.is-open .site-header__menu-icon::before {
    transform: rotate(45deg);
  }

  .site-header.is-open .site-header__menu-icon::after {
    transform: rotate(-45deg);
  }

  @media (max-width: 50rem) {
    .site-header__inner {
      min-height: 4.25rem;
    }

    .site-header__nav {
      position: relative;
    }

    .site-header__links {
      position: absolute;
      top: calc(100% + var(--space-sm));
      right: 0;
      display: grid;
      width: min(18rem, calc(100vw - (var(--container-padding) * 2)));
      gap: var(--space-xs);
      padding: var(--space-sm);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-glass-strong);
      box-shadow: var(--shadow-card);
      backdrop-filter: blur(calc(var(--blur-glass) + 8px)) saturate(150%);
      -webkit-backdrop-filter: blur(calc(var(--blur-glass) + 8px)) saturate(150%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-0.5rem);
      transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out), visibility var(--duration-base) var(--ease-out);
    }

    .site-header__links {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }

    .site-header__link {
      border-radius: var(--radius-md);
      padding: 0.75rem 0.9rem;
      background: rgb(255 255 255 / 0.045);
    }

    .site-header__cta--desktop {
      display: none;
    }

    .site-header__cta--mobile {
      display: inline-flex;
      justify-content: center;
      margin-block-start: 0.25rem;
    }

    .site-header.is-open .site-header__links {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-header__menu-toggle {
      display: grid;
    }
  }
</style>
