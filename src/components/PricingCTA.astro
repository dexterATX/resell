</section>

<style>
  .pricing-cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .pricing-cta__mesh {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 50% 0%, rgb(124 58 237 / 0.34), transparent 34%),
      radial-gradient(circle at 10% 90%, rgb(251 113 133 / 0.22), transparent 34%),
      radial-gradient(circle at 90% 82%, rgb(6 182 212 / 0.2), transparent 32%);
    filter: blur(10px);
  }

  .pricing-cta__container {
    display: grid;
    gap: var(--space-xl);
  }

  .pricing-cta__top {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 0.72fr);
    gap: var(--space-lg);
    align-items: center;
  }

  .pricing-cta__header {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    max-width: 42rem;
  }

  .pricing-cta__copy {
    color: var(--color-fog);
    font-size: var(--step-1);
  }

  .pricing-cta__card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.25rem, 2.4vw, 2rem);
  }

  .pricing-cta__card-glow {
    position: absolute;
    inset: -35% -35% auto auto;
    width: 18rem;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--gradient-warm);
    filter: blur(60px);
    opacity: 0.32;
    animation: pricing-cta__orbit 9s linear infinite;
  }

  .pricing-cta__price-row,
  .pricing-cta__price,
  .pricing-cta__features,
  .pricing-cta__button {
    position: relative;
    z-index: 1;
  }

  .pricing-cta__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .pricing-cta__price-label,
  .pricing-cta__badge {
    border-radius: var(--radius-full);
    padding: 0.45rem 0.7rem;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pricing-cta__price-label {
    background: var(--gradient-primary);
    color: var(--color-soft-white);
  }

  .pricing-cta__badge {
    border: 1px solid rgb(251 191 36 / 0.35);
    background: rgb(251 191 36 / 0.12);
    color: var(--color-amber);
  }

  .pricing-cta__price {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    margin-block-start: var(--space-sm);
    color: var(--color-soft-white);
    font-family: var(--font-display);
    font-size: clamp(4.8rem, 13vw, 8.8rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 0.82;
  }

  .pricing-cta__currency,
  .pricing-cta__unit {
    color: var(--color-muted-slate);
    font-size: var(--step-0);
    letter-spacing: -0.04em;
  }

  .pricing-cta__unit {
    align-self: flex-end;
    margin-block-end: 0.55rem;
  }

  .pricing-cta__price-copy {
    position: relative;
    z-index: 1;
    color: var(--color-fog);
    font-size: var(--step-0);
  }

  .pricing-cta__features {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-xs);
    margin-block: var(--space-md) var(--space-lg);
    padding: 0;
    list-style: none;
  }

  .pricing-cta__features li {
    position: relative;
    padding-inline-start: 1.8rem;
    color: var(--color-soft-white);
  }

  .pricing-cta__features li::before {
    position: absolute;
    inset-block-start: 0.25rem;
    inset-inline-start: 0;
    display: grid;
    width: 1.15rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
    color: var(--color-soft-white);
    content: "✓";
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1;
  }

  .pricing-cta__button {
    width: 100%;
  }

  .pricing-cta__faq-wrap {
    padding: clamp(1.1rem, 2vw, 1.6rem);
  }

  .pricing-cta__faq-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-inline-end: var(--space-sm);
  }

  .pricing-cta__faq-header h3 {
    margin-block-start: var(--space-xs);
    font-size: var(--step-3);
  }

  .pricing-cta__eyebrow-small,
  .pricing-cta__faq-note {
    color: var(--color-aero-cyan);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-cta__faq-note {
    white-space: nowrap;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.45rem 0.7rem;
    background: rgb(6 182 212 / 0.08);
  }

  .pricing-cta__faq-list {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
  }

  .pricing-cta__faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.045);
  }

  .pricing-cta__faq-item h4 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
  }

  .pricing-cta__faq-button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    border: 0;
    border-radius: var(--radius-lg);
    padding: var(--space-sm);
    background: transparent;
    color: var(--color-soft-white);
    font-family: var(--font-display);
    font-weight: 800;
    text-align: left;
    cursor: pointer;
  }

  .pricing-cta__faq-icon {
    position: relative;
    flex: 0 0 auto;
    width: 1.15rem;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: rgb(6 182 212 / 0.12);
    transition: transform var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }

  .pricing-cta__faq-icon::before,
  .pricing-cta__faq-icon::after {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.62rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-aero-cyan);
    content: "";
    transform: translate(-50%, -50%);
  }

  .pricing-cta__faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .pricing-cta__faq-button[aria-expanded="true"] .pricing-cta__faq-icon {
    background: var(--gradient-primary);
    transform: rotate(180deg);
  }

  .pricing-cta__faq-button[aria-expanded="true"] .pricing-cta__faq-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .pricing-cta__faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-base) var(--ease-out);
  }

  .pricing-cta__faq-panel > p {
    overflow: hidden;
  }

  .pricing-cta__faq-panel {
    padding: 0 var(--space-sm);
  }

  .pricing-cta__faq-item.is-open .pricing-cta__faq-panel {
    grid-template-rows: 1fr;
    padding-block-end: var(--space-sm);
  }

  .pricing-cta__faq-item p {
    color: var(--color-fog);
    font-size: var(--step--1);
  }

  .pricing-cta__final-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    border-radius: var(--radius-2xl);
    padding: clamp(1.2rem, 3vw, 2rem);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.13), rgb(255 255 255 / 0.04)),
      var(--gradient-primary);
    box-shadow: var(--shadow-card), var(--shadow-glow);
  }

  .pricing-cta__final-band h3 {
    margin-block-start: var(--space-xs);
    font-size: clamp(1.8rem, 3.8vw, 3.6rem);
  }

  .pricing-cta__final-band .btn {
    flex: 0 0 auto;
    background: var(--color-soft-white);
    color: var(--color-electric-violet);
  }

  @media (max-width: 62rem) {
    .pricing-cta__top {
      grid-template-columns: 1fr;
    }

    .pricing-cta__header {
      justify-items: center;
      text-align: center;
    }

    .pricing-cta__final-band {
      align-items: stretch;
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 46rem) {
    .pricing-cta__faq-header {
      flex-direction: column;
    }

    .pricing-cta__faq-note {
      align-self: flex-start;
    }

    .pricing-cta__faq-button {
      align-items: flex-start;
    }
  }

  @keyframes pricing-cta__orbit {
    to {
      transform: rotate(1turn);
    }
  }
</style>

<script>
  document.querySelectorAll('[data-faq-item]').forEach((item) => {
    const button = item.querySelector('.pricing-cta__faq-button');
    const panel = item.querySelector('.pricing-cta__faq-panel');

    button.addEventListener('click', () => {
      const isOpen = item.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(isOpen));
      panel.hidden = !isOpen;
    });

    panel.hidden = true;
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.18 });

  document.querySelectorAll('.pricing-cta .reveal').forEach((element) => observer.observe(element));
</script>
