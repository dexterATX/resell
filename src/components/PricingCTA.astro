<section id="pricing" class="section pricing-cta" aria-labelledby="pricing-title">
  <div class="pricing-cta__mesh" aria-hidden="true"></div>

  <div class="container pricing-cta__container">
    <div class="pricing-cta__top reveal">
      <div class="pricing-cta__header">
        <p class="eyebrow">Lock in your flat fare</p>
        <h2 id="pricing-title" class="text-balance">One bold price. Every route you want.</h2>
        <p class="pricing-cta__copy text-pretty">
          Skip fare roulette. Choose from discounted seats, pay one transparent flat rate, and keep the savings.
        </p>
      </div>

      <article class="pricing-cta__card glass-strong gradient-border reveal" style="--reveal-delay: 140ms">
        <div class="pricing-cta__card-glow" aria-hidden="true"></div>
