---
interface FlatRatePricingProps {
  eyebrow?: string;
  title?: string;
  copy?: string;
  flatRate?: string;
  label?: string;
}

const {
  eyebrow = 'Flat-rate pricing',
  title = 'One discounted fare. Zero markup games.',
  copy = 'SkyResell turns volatile airline inventory into one transparent flat rate, so you can compare routes without decoding fees at checkout.',
  flatRate = '$199',
  label = 'Flat fare',
}: FlatRatePricingProps = Astro.props as FlatRatePricingProps;
---

<section class="pricing-section" aria-labelledby="pricing-heading">
  <div class="pricing-hero">
    <div class="pricing-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="pricing-heading" class="gradient-text">{title}</h2>
      <p>{copy}</p>
    </div>

    <div class="price-card glass" aria-label={`Flat rate ${flatRate}`}>
      <span>{label}</span>
      <strong>{flatRate}</strong>
      <p>per discounted ticket bundle</p>
    </div>
  </div>

  <div class="value-grid">
    <article class="value-card">
      <span class="value-icon">01</span>
      <h3>No hidden fees</h3>
      <p>Taxes, carrier charges, and service fees are folded into one upfront flat price.</p>
    </article>

    <article class="value-card">
      <span class="value-icon">02</span>
      <h3>No route markup</h3>
      <p>Popular routes do not get punished with surprise premiums at checkout.</p>
    </article>

    <article class="value-card">
      <span class="value-icon">03</span>
      <h3>No fare confusion</h3>
      <p>Search, pick, and pay with one clear rate instead of comparing endless fare buckets.</p>
    </article>
  </div>
</section>

<style>
  .pricing-section {
    width: min(100% - 2rem, 76rem);
    margin-inline: auto;
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .pricing-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    border-radius: clamp(1.75rem, 4vw, 3rem);
    padding: clamp(1.5rem, 5vw, 4rem);
    background:
      radial-gradient(circle at 12% 15%, rgba(14, 165, 233, 0.28), transparent 32%),
      radial-gradient(circle at 86% 18%, rgba(124, 58, 237, 0.24), transparent 34%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(240, 249, 255, 0.72));
    border: 1px solid rgba(14, 165, 233, 0.2);
    box-shadow: 0 32px 90px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(18px);
    overflow: hidden;
  }

  .pricing-hero::after {
    content: '';
    position: absolute;
    inset: auto -12% -45% 34%;
    height: 70%;
    background: linear-gradient(90deg, rgba(14, 165, 233, 0.16), rgba(168, 85, 247, 0.18), rgba(34, 197, 94, 0.12));
    filter: blur(38px);
    transform: rotate(-6deg);
  }

  .pricing-copy {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: #0284c7;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .gradient-text {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.45rem, 7vw, 5.6rem);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: -0.08em;
    background: linear-gradient(135deg, #0f172a 8%, #0ea5e9 42%, #7c3aed 76%, #16a34a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pricing-copy > p:last-child {
    max-width: 40rem;
    margin: 1.1rem 0 0;
    color: #475569;
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    font-weight: 650;
    line-height: 1.75;
  }

  .price-card {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.4rem;
    border-radius: 2rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background:
      linear-gradient(145deg, rgba(15, 23, 42, 0.94), rgba(30, 41, 59, 0.88)),
      radial-gradient(circle at top right, rgba(14, 165, 233, 0.35), transparent 38%);
    color: #fff;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.24);
    overflow: hidden;
  }

  .price-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.28), rgba(168, 85, 247, 0.18));
    opacity: 0.8;
  }

  .price-card > * {
    position: relative;
  }

  .price-card span,
  .price-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .price-card strong {
    font-size: clamp(4rem, 10vw, 6.8rem);
    line-height: 0.85;
    letter-spacing: -0.09em;
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .value-card {
    min-height: 15rem;
    border-radius: 1.5rem;
    padding: 1.35rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(14, 165, 233, 0.18);
    box-shadow: 0 22px 60px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(16px);
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .value-card:hover {
    transform: translateY(-0.45rem);
    border-color: rgba(14, 165, 233, 0.38);
  }

  .value-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.1rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #0ea5e9, #7c3aed);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 950;
    letter-spacing: 0.12em;
  }

  .value-card h3 {
    margin: 0 0 0.55rem;
    color: #0f172a;
    font-size: 1.15rem;
    font-weight: 950;
  }

  .value-card p {
    margin: 0;
    color: #475569;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.65;
  }

  @media (max-width: 58rem) {
    .pricing-hero,
    .value-grid {
      grid-template-columns: 1fr;
    }

    .price-card {
      width: min(100%, 28rem);
    }
  }

  @media (max-width: 40rem) {
    .pricing-section {
      width: min(100% - 1rem, 76rem);
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }

    .pricing-hero {
      padding: 1.1rem;
    }

    .gradient-text {
      max-width: 11ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-card {
      transition: none;
    }

    .value-card:hover {
      transform: none;
    }
  }
</style>
