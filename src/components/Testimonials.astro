---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  initials: string;
}

interface TestimonialsProps {
  eyebrow?: string;
  title?: string;
  copy?: string;
  testimonials?: Testimonial[];
}

const defaultTestimonials: Testimonial[] = [
  {
    quote: 'I booked MIA to Paris for less than half the normal fare. The flat price made the decision easy.',
    name: 'Maya Chen',
    role: 'Weekend traveler',
    initials: 'MC',
  },
  {
    quote: 'No surprise fees, no fare maze. SkyResell gave me the same clear price from search to checkout.',
    name: 'Andre Williams',
    role: 'Frequent flyer',
    initials: 'AW',
  },
  {
    quote: 'The ticket was legit, the savings were real, and the whole process felt surprisingly premium.',
    name: 'Priya Shah',
    role: 'Family trip planner',
    initials: 'PS',
  },
];

const {
  eyebrow = 'Traveler proof',
  title = 'Flat fares travelers trust.',
  copy = 'Short stories from people who skipped the fare guessing game and locked a better price.',
  testimonials = defaultTestimonials,
}: TestimonialsProps = Astro.props as TestimonialsProps;
---

<section class="testimonials-section" aria-labelledby="testimonials-heading">
  <div class="section-head">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="testimonials-heading" class="gradient-text">{title}</h2>
    <p>{copy}</p>
  </div>

  <div class="testimonial-track" aria-label="Customer testimonials">
    {
      testimonials.map((testimonial: Testimonial) => (
        <article class="testimonial-card glass">
          <div class="quote-mark" aria-hidden="true">“</div>
          <p>{testimonial.quote}</p>
          <footer>
            <div class="avatar" aria-hidden="true">{testimonial.initials}</div>
            <div>
              <strong>{testimonial.name}</strong>
              <span>{testimonial.role}</span>
            </div>
          </footer>
        </article>
      ))
    }
  </div>
</section>

<style>
  .testimonials-section {
    width: min(100% - 2rem, 76rem);
    margin-inline: auto;
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: #0284c7;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .gradient-text {
    margin: 0;
    font-size: clamp(2.35rem, 6.6vw, 5.1rem);
    font-weight: 950;
    line-height: 0.94;
    letter-spacing: -0.08em;
    background: linear-gradient(135deg, #0f172a 10%, #0ea5e9 44%, #7c3aed 78%, #16a34a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .section-head > p:last-child {
    margin: 1rem 0 0;
    color: #475569;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    font-weight: 650;
    line-height: 1.7;
  }

  .testimonial-track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    overflow-x: auto;
    padding: 0.25rem 0.25rem 1rem;
    scroll-snap-type: x mandatory;
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    min-height: 20rem;
    border-radius: 1.5rem;
    padding: 1.35rem;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.84), rgba(240, 249, 255, 0.7)),
      radial-gradient(circle at top right, rgba(124, 58, 237, 0.18), transparent 36%);
    border: 1px solid rgba(168, 85, 247, 0.18);
    box-shadow: 0 24px 68px rgba(15, 23, 42, 0.1);
    backdrop-filter: blur(18px);
    scroll-snap-align: start;
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .testimonial-card:hover {
    transform: translateY(-0.5rem);
    border-color: rgba(124, 58, 237, 0.38);
  }

  .quote-mark {
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #0ea5e9, #7c3aed);
    color: #fff;
    font-size: 2rem;
    font-weight: 950;
    line-height: 1;
  }

  .testimonial-card > p {
    flex: 1;
    margin: 1.35rem 0 1.5rem;
    color: #1e293b;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.7;
  }

  .testimonial-card footer {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #0f172a, #0ea5e9);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 950;
    letter-spacing: 0.08em;
  }

  .testimonial-card footer div:last-child {
    display: grid;
    gap: 0.18rem;
  }

  .testimonial-card footer strong {
    color: #0f172a;
    font-weight: 950;
  }

  .testimonial-card footer span {
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 62rem) {
    .testimonial-track {
      grid-template-columns: repeat(2, minmax(16rem, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .testimonials-section {
      width: min(100% - 1rem, 76rem);
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }

    .testimonial-track {
      grid-template-columns: minmax(18rem, 0.9fr);
      padding-bottom: 0.5rem;
    }

    .testimonial-card {
      min-height: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-card {
      transition: none;
    }

    .testimonial-card:hover {
      transform: none;
    }
  }
</style>
