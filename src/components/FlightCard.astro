---
interface FlightCardProps {
  route: string;
  price: string | number;
  originalPrice: string | number;
  airline: string;
  date: string;
  time?: string;
  seats?: string;
  tag?: string;
  className?: string;
}

const {
  route,
  price,
  originalPrice,
  airline,
  date,
  time,
  seats = 'Limited seats',
  tag = 'Flat Rate',
  className = '',
}: FlightCardProps = Astro.props as FlightCardProps;
---

<article class={`flight-card glass ${className}`}>
  <div class="card-top">
    <span class="route-badge">{route}</span>
    <span class="tag">{tag}</span>
  </div>

  <div class="route-line" aria-hidden="true">
    <span class="dot"></span>
    <span class="line"></span>
    <span class="dot"></span>
  </div>

  <div class="card-body">
    <div class="flight-meta">
      <span>{airline}</span>
      <span>{date}</span>
      {time ? <span>{time}</span> : null}
      <span>{seats}</span>
    </div>

    <div class="pricing">
      <div>
        <p class="price-label">Flat fare</p>
        <p class="flat-price">{price}</p>
      </div>
      <p class="original-price" aria-label={`Regular price ${originalPrice}`}>{originalPrice}</p>
    </div>
  </div>

  <a class="deal-link" href="#pricing" aria-label={`Claim flat fare for ${route}`}>
    Claim flat fare
  </a>
</article>

<style>
  .flight-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(14, 165, 233, 0.2);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(240, 249, 255, 0.74)),
      radial-gradient(circle at top right, rgba(14, 165, 233, 0.28), transparent 38%);
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(18px);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .flight-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.45), rgba(168, 85, 247, 0.28), rgba(34, 197, 94, 0.22));
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .flight-card:hover {
    transform: translateY(-0.65rem);
    border-color: rgba(14, 165, 233, 0.42);
    box-shadow: 0 32px 90px rgba(2, 132, 199, 0.22);
  }

  .flight-card:hover::before {
    opacity: 1;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.25rem 0;
  }

  .route-badge {
    display: inline-flex;
    width: fit-content;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.92);
    padding: 0.5rem 0.75rem;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tag {
    border-radius: 9999px;
    background: rgba(34, 197, 94, 0.12);
    padding: 0.45rem 0.7rem;
    color: #15803d;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .route-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 1.35rem 1.25rem 0;
    color: rgba(15, 23, 42, 0.46);
  }

  .dot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #0ea5e9, #a855f7);
    box-shadow: 0 0 0 0.35rem rgba(14, 165, 233, 0.12);
  }

  .line {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, rgba(14, 165, 233, 0.12), rgba(168, 85, 247, 0.35), rgba(34, 197, 94, 0.18));
  }

  .card-body {
    padding: 1.25rem;
  }

  .flight-meta {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    color: #475569;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .flight-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.5rem;
  }

  .flight-meta span + span::before {
    content: '';
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 9999px;
    background: #38bdf8;
  }

  .pricing {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .price-label {
    margin-bottom: 0.18rem;
    color: #64748b;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .flat-price {
    margin: 0;
    color: #0f172a;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 950;
    line-height: 0.95;
    letter-spacing: -0.08em;
  }

  .original-price {
    margin: 0 0 0.35rem;
    color: #94a3b8;
    font-size: 0.92rem;
    font-weight: 900;
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    white-space: nowrap;
  }

  .deal-link {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 1.25rem 1.25rem;
    min-height: 3rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #0ea5e9, #7c3aed);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 900;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
    box-shadow: 0 16px 36px rgba(124, 58, 237, 0.28);
  }

  .deal-link:hover,
  .deal-link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 20px 44px rgba(14, 165, 233, 0.34);
    outline: 3px solid rgba(14, 165, 233, 0.28);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .flight-card,
    .flight-card::before,
    .deal-link {
      transition: none;
    }

    .flight-card:hover {
      transform: none;
    }
  }
</style>
